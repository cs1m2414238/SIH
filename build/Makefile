	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_sourcetable.dir/build.make CMakeFiles/test_sourcetable.dir/tests/test_sourcetable.cpp.i
.PHONY : tests/test_sourcetable.cpp.i

tests/test_sourcetable.s: tests/test_sourcetable.cpp.s
.PHONY : tests/test_sourcetable.s

# target to generate assembly for a file
tests/test_sourcetable.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_sourcetable.dir/build.make CMakeFiles/test_sourcetable.dir/tests/test_sourcetable.cpp.s
.PHONY : tests/test_sourcetable.cpp.s

